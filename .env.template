# Copy this file to .env and fill in values before running `docker-compose up` from infra/.

# --- Postgres ---
POSTGRES_DB=nutricheck
POSTGRES_USER=nutricheck
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- API (NutriCheck.Api) ---
# Connection string used by the API container. Host is the docker-compose service name,
# not localhost - the API talks to Postgres over the Docker network, not the host network.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=nutricheck;Username=nutricheck;Password=changeme
API_PORT=5080

# --- Web (Next.js) ---
# Read by the browser (NEXT_PUBLIC_* vars are inlined at build time), so this must be a
# URL reachable from the host machine's browser, not the Docker-internal service name.
NEXT_PUBLIC_API_URL=http://localhost:5080
# Read only by the web app's server (route handlers, server components), which runs
# inside the Docker network - so this must be the api service's Docker hostname, not
# localhost or the host-visible API_PORT.
API_INTERNAL_URL=http://api:8080
WEB_PORT=3000
